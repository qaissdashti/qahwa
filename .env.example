# ─────────────────────────────────────────────────────────
# Qahwa — Environment Variables
# Copy to .env.local for development
# Add ALL to Vercel project settings for production
# ─────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://qahwa.kw
# For local dev: NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# WARNING: Never expose this key to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── MyFatoorah ────────────────────────────────────────────
# Test: https://apitest.myfatoorah.com
# Live: https://api.myfatoorah.com
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_API_KEY=rLtt6JWvbUHDDhsZnfpAhpYk4dxYDQkbcPTyGaKp...
MYFATOORAH_WEBHOOK_SECRET=your_webhook_secret_from_myfatoorah_dashboard

# ── WhatsApp (360dialog) ──────────────────────────────────
WHATSAPP_API_TOKEN=your_360dialog_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# The Qahwa platform WhatsApp number (what everyone sees)
WHATSAPP_PLATFORM_NUMBER=+96512345678
WA_PROVIDER=360dialog

# ── Security ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CIVIL_ID_ENCRYPTION_KEY=a1b2c3d4e5f6...64_hex_chars_here

# ── Admin ─────────────────────────────────────────────────
# God admin WhatsApp number for payout alerts
ADMIN_WHATSAPP_NUMBER=+96599999999
