# ─────────────────────────────────────────────────────────
# Qahwa — Environment Variables
# Copy to .env.local for development
# Add ALL to Vercel project settings for production
# ─────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://buymeqahwa.com
# For local dev: NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# WARNING: Never expose this key to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── MyFatoorah ────────────────────────────────────────────
# Test: https://apitest.myfatoorah.com
# Live: https://api.myfatoorah.com
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_API_KEY=rLtt6JWvbUHDDhsZnfpAhpYk4dxYDQkbcPTyGaKp...
MYFATOORAH_WEBHOOK_SECRET=your_webhook_secret_from_myfatoorah_dashboard

# ── WhatsApp OTP (Twilio) ─────────────────────────────────
# OTP codes are sent over WhatsApp via Twilio. The sandbox From
# number is +14155238886; recipients must join the sandbox first.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# ── WhatsApp (legacy Meta Cloud API — feature gating only) ─
# No longer used for OTP (Twilio replaces it) or tip notifications
# (email replaces it). Kept because the onboarding/verify flow still
# checks WHATSAPP_API_TOKEN to decide whether the WhatsApp step is
# available, and adminNotify can still ping the admin over WhatsApp.
WHATSAPP_API_TOKEN=your_360dialog_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# The Qahwa platform WhatsApp number (what everyone sees)
WHATSAPP_PLATFORM_NUMBER=+96512345678
WA_PROVIDER=360dialog

# ── Security ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CIVIL_ID_ENCRYPTION_KEY=a1b2c3d4e5f6...64_hex_chars_here

# ── Admin ─────────────────────────────────────────────────
# God admin WhatsApp number for payout alerts
ADMIN_WHATSAPP_NUMBER=+96599999999

# ── Dev ───────────────────────────────────────────────────
# Set to "true" in local dev to skip WhatsApp OTP delivery and return the
# code in the API response (lets you finish onboarding without WhatsApp).
# Hard-disabled when NODE_ENV=production. Never set in production.
DEV_OTP_BYPASS=false

# Simulate successful KNET payments when MYFATOORAH_API_KEY is empty —
# marks the tip paid (fires the balance trigger) and redirects to the
# success screen. Auto-on outside production; in production it requires
# explicit PAYMENT_TEST_MODE=true (e.g. for a pre-launch Vercel preview).
# Leave unset for real production.
PAYMENT_TEST_MODE=false
